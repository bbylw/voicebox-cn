---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/dm-sans";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voicebox | 开源 AI 语音工作室</title>
    <link rel="canonical" href="https://voicebox.ndjp.net/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voicebox" />
    <meta property="og:title" content="Voicebox | 开源 AI 语音工作室" />
    <meta
      property="og:description"
      content="克隆任意声音、生成自然语音、全局听写进任何应用，并让智能体用你的声音说话，全部在本地运行。"
    />
    <meta
      name="description"
      content="开源 AI 语音工作室。克隆任意声音、生成自然语音、全局听写进任何应用，并让 AI 智能体用你的声音说话，全部在本地运行。"
    />
    <style is:global>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* Studio console palette: deep acoustic obsidian + signal vermilion */
        --bg: #0b0d10;
        --bg-surface: #12151a;
        --bg-elevated: #171b22;
        --bg-hover: #1d222b;
        --border: rgba(244, 245, 247, 0.08);
        --border-strong: rgba(244, 245, 247, 0.16);
        --text: #f4f5f7;
        --text-secondary: #a6adb9;
        --text-muted: #848c9a;
        --accent: #f06434;
        --accent-hover: #ff7647;
        --accent-soft: rgba(240, 100, 52, 0.14);
        --accent-border: rgba(240, 100, 52, 0.36);

        /* Typography: 2 families + strict 3-size body scale */
        --font-display: "Space Grotesk Variable", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        --font-body: "DM Sans Variable", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

        --text-heading: clamp(1.75rem, 3.2vw, 2.5rem);
        --text-body: 1rem;
        --text-sm: 0.875rem;

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        scroll-behavior: smooth;
        scrollbar-width: thin;
        scrollbar-color: #2a303b var(--bg);
      }

      body {
        font-family: var(--font-body);
        font-size: var(--text-body);
        line-height: 1.65;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 600;
        letter-spacing: -0.025em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font-family: inherit;
        color: inherit;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .tabular {
        font-variant-numeric: tabular-nums;
      }

      .container {
        width: 100%;
        max-width: 1160px;
        margin: 0 auto;
        padding-inline: 24px;
      }

      /* ---- HEADER ---- */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background-color 200ms var(--ease), border-color 200ms var(--ease), backdrop-filter 200ms var(--ease);
      }

      .nav.scrolled {
        background: rgba(11, 13, 16, 0.84);
        backdrop-filter: blur(16px) saturate(1.3);
        border-bottom-color: var(--border);
      }

      .nav-inner {
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .nav-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.03em;
        color: var(--text);
      }

      .nav-logo-mark {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--accent);
        color: #0b0d10;
        display: grid;
        place-items: center;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-secondary);
        transition: color 160ms var(--ease);
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .nav-gh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-secondary);
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        transition: color 160ms var(--ease), background-color 160ms var(--ease);
      }

      .nav-gh:hover {
        color: var(--text);
        background: rgba(244, 245, 247, 0.05);
      }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        font-size: var(--text-sm);
        font-weight: 600;
        background: var(--text);
        color: var(--bg);
        transition: background-color 160ms var(--ease), transform 160ms var(--ease);
      }

      .nav-cta:hover {
        background: #ffffff;
        transform: translateY(-1px);
      }

      .mobile-menu-btn {
        display: none;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        background: none;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text);
        cursor: pointer;
      }

      .mobile-drawer {
        display: none;
        position: fixed;
        top: 68px;
        left: 0;
        right: 0;
        z-index: 99;
        background: rgba(11, 13, 16, 0.96);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid var(--border);
        padding: 16px 24px 24px;
      }

      .mobile-drawer.open {
        display: block;
      }

      .mobile-drawer-links {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .mobile-drawer-links a {
        padding: 12px 0;
        font-size: var(--text-body);
        font-weight: 500;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border);
      }

      .mobile-drawer-links a:last-child {
        border-bottom: none;
      }

      @media (max-width: 768px) {
        .nav-links,
        .nav-gh {
          display: none;
        }
        .mobile-menu-btn {
          display: inline-flex;
        }
      }

      /* ---- HERO ---- */
      .hero {
        position: relative;
        padding: 132px 0 88px;
        overflow: hidden;
        background:
          radial-gradient(64% 48% at 50% 0%, rgba(240, 100, 52, 0.14) 0%, rgba(240, 100, 52, 0.03) 48%, transparent 76%),
          linear-gradient(180deg, #0e1116 0%, var(--bg) 52%);
      }

      .hero-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(244, 245, 247, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(244, 245, 247, 0.035) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 80% 55% at 50% 18%, #000 20%, transparent 78%);
        pointer-events: none;
      }

      .hero-header {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 920px;
        margin: 0 auto 48px;
      }

      .hero h1 {
        font-size: clamp(3rem, 7.2vw, 5.75rem);
        line-height: 1.04;
        letter-spacing: -0.04em;
        margin-bottom: 20px;
      }

      .hero-sub {
        font-size: var(--text-body);
        color: var(--text-secondary);
        max-width: 56ch;
        margin: 0 auto 30px;
      }

      .hero-cta-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 28px;
        border-radius: var(--radius-sm);
        font-family: var(--font-display);
        font-size: var(--text-body);
        font-weight: 600;
        background: var(--accent);
        color: #0b0d10;
        transition: background-color 160ms var(--ease), transform 160ms var(--ease);
      }

      .btn-primary:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
      }

      .hero-meta {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      /* ---- INTERACTIVE STUDIO WORKBENCH ---- */
      .workbench {
        position: relative;
        z-index: 1;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-strong);
        background: var(--bg-surface);
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.55);
      }

      .wb-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.28);
      }

      .wb-dots {
        display: flex;
        gap: 7px;
      }

      .wb-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: rgba(244, 245, 247, 0.16);
      }

      .wb-dot.rec {
        background: var(--accent);
      }

      .wb-title {
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-secondary);
      }

      .wb-status {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .wb-body {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 410px;
      }

      @media (max-width: 820px) {
        .wb-body {
          grid-template-columns: 1fr;
        }
        .wb-sidebar {
          border-right: none;
          border-bottom: 1px solid var(--border);
        }
      }

      .wb-sidebar {
        border-right: 1px solid var(--border);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        background: rgba(0, 0, 0, 0.14);
      }

      .wb-sidebar-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 4px 8px 10px;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--text-secondary);
      }

      .voice-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border-radius: var(--radius-sm);
        border: 1px solid transparent;
        background: transparent;
        text-align: left;
        cursor: pointer;
        transition: background-color 160ms var(--ease), border-color 160ms var(--ease);
      }

      .voice-btn:hover {
        background: rgba(244, 245, 247, 0.04);
      }

      .voice-btn[aria-pressed="true"] {
        background: var(--accent-soft);
        border-color: var(--accent-border);
      }

      .voice-avatar {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: grid;
        place-items: center;
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
      }

      .voice-info {
        min-width: 0;
        flex: 1;
      }

      .voice-name {
        display: block;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .voice-desc {
        display: block;
        font-size: var(--text-sm);
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .wb-main {
        display: flex;
        flex-direction: column;
      }

      .wb-composer {
        padding: 20px 22px;
        border-bottom: 1px solid var(--border);
      }

      .wb-prompt {
        width: 100%;
        padding: 14px 16px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: var(--text-sm);
        line-height: 1.5;
        margin-bottom: 14px;
      }

      .wb-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }

      /* Connected segmented control for engine selection */
      .segmented {
        display: inline-flex;
        padding: 3px;
        border-radius: var(--radius-sm);
        background: var(--bg);
        border: 1px solid var(--border);
        gap: 2px;
        flex-wrap: wrap;
      }

      .seg-btn {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        background: transparent;
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-muted);
        cursor: pointer;
        transition: background-color 160ms var(--ease), color 160ms var(--ease);
      }

      .seg-btn:hover {
        color: var(--text);
      }

      .seg-btn[aria-pressed="true"] {
        background: var(--bg-elevated);
        color: var(--text);
        box-shadow: inset 0 0 0 1px var(--border-strong);
      }

      .wb-engine-note {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .gen-list {
        flex: 1;
        padding: 8px 22px 16px;
        display: flex;
        flex-direction: column;
      }

      .gen-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 4px;
        border-bottom: 1px solid var(--border);
        transition: background-color 160ms var(--ease);
      }

      .gen-row:last-child {
        border-bottom: none;
      }

      .gen-play {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border-strong);
        background: var(--bg);
        color: var(--text);
        display: grid;
        place-items: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 160ms var(--ease), border-color 160ms var(--ease), color 160ms var(--ease);
      }

      .gen-play:hover,
      .gen-play.playing {
        background: var(--accent);
        border-color: var(--accent);
        color: #0b0d10;
      }

      .gen-meta {
        flex: 1;
        min-width: 0;
      }

      .gen-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 2px;
      }

      .gen-speaker {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--text);
      }

      .gen-specs {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .gen-text {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Studio Transport Bar */
      .wb-transport {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 22px;
        border-top: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.34);
      }

      .transport-speaker {
        font-size: var(--text-sm);
        font-weight: 600;
        min-width: 110px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .wave-wrap {
        flex: 1;
        height: 34px;
        display: flex;
        align-items: center;
        gap: 3px;
        overflow: hidden;
      }

      .wave-bar {
        flex: 1;
        min-width: 2px;
        border-radius: 2px;
        background: rgba(244, 245, 247, 0.22);
        transition: background-color 140ms var(--ease), transform 140ms var(--ease);
      }

      .wave-bar.active {
        background: var(--accent);
      }

      .transport-time {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        white-space: nowrap;
      }

      /* ---- VOICE STRIP ---- */
      .voice-strip {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 18px 0;
        overflow: hidden;
        position: relative;
        background: rgba(255, 255, 255, 0.015);
      }

      .voice-strip::before,
      .voice-strip::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 96px;
        z-index: 2;
        pointer-events: none;
      }

      .voice-strip::before {
        left: 0;
        background: linear-gradient(90deg, var(--bg), transparent);
      }

      .voice-strip::after {
        right: 0;
        background: linear-gradient(-90deg, var(--bg), transparent);
      }

      .marquee-track {
        display: flex;
        gap: 36px;
        width: max-content;
        animation: scroll-left 44s linear infinite;
      }

      .voice-strip:hover .marquee-track {
        animation-play-state: paused;
      }

      @keyframes scroll-left {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      .marquee-item {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .mc-avatar {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        display: grid;
        place-items: center;
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 700;
        color: #fff;
      }

      .mc-name {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--text);
      }

      .mc-desc {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      /* ---- SECTIONS ---- */
      .section {
        padding: 104px 0;
      }

      .section-rule {
        border: none;
        border-top: 1px solid var(--border);
      }

      .section-head {
        max-width: 680px;
        margin-bottom: 56px;
      }

      .section-title {
        font-size: var(--text-heading);
        line-height: 1.15;
        margin-bottom: 16px;
      }

      .section-desc {
        font-size: var(--text-body);
        color: var(--text-secondary);
        max-width: 60ch;
      }

      /* ---- CAPABILITIES (EDITORIAL RULED GRID) ---- */
      .cap-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--border);
        border-left: 1px solid var(--border);
      }

      @media (max-width: 900px) {
        .cap-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .cap-grid {
          grid-template-columns: 1fr;
        }
      }

      .cap-cell {
        padding: 32px 28px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: transparent;
        transition: background-color 180ms var(--ease);
      }

      .cap-cell:hover {
        background: var(--bg-surface);
      }

      .cap-icon {
        width: 36px;
        height: 36px;
        margin-bottom: 20px;
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: flex-start;
      }

      .cap-cell h3 {
        font-size: var(--text-body);
        font-weight: 600;
        margin-bottom: 10px;
        color: var(--text);
      }

      .cap-cell p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: 1.65;
      }

      /* ---- VOICE CLONE (ASYMMETRIC STAGE) ---- */
      .clone-layout {
        display: grid;
        grid-template-columns: 1.05fr 1.25fr;
        gap: 64px;
        align-items: start;
      }

      @media (max-width: 860px) {
        .clone-layout {
          grid-template-columns: 1fr;
          gap: 40px;
        }
      }

      .clone-list {
        border-top: 1px solid var(--border);
      }

      .clone-row {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 20px;
        padding: 28px 0;
        border-bottom: 1px solid var(--border);
        align-items: start;
      }

      .clone-row-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--accent);
        display: grid;
        place-items: center;
      }

      .clone-row h3 {
        font-size: var(--text-body);
        font-weight: 600;
        margin-bottom: 6px;
      }

      .clone-row p {
        font-size: var(--text-sm);
        color: var(--text-secondary);
      }

      /* ---- ENGINES MATRIX ---- */
      .engines-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        margin-bottom: 40px;
      }

      .engines-top .section-head {
        margin-bottom: 0;
      }

      .engine-list {
        border-top: 1px solid var(--border);
      }

      .engine-row {
        display: grid;
        grid-template-columns: 240px 1fr 220px;
        gap: 24px;
        padding: 24px 12px;
        border-bottom: 1px solid var(--border);
        align-items: baseline;
        transition: background-color 160ms var(--ease);
      }

      .engine-row:hover {
        background: var(--bg-surface);
      }

      .engine-row[hidden] {
        display: none;
      }

      @media (max-width: 860px) {
        .engine-row {
          grid-template-columns: 1fr;
          gap: 8px;
          padding: 20px 4px;
        }
      }

      .engine-name {
        font-family: var(--font-display);
        font-size: var(--text-body);
        font-weight: 600;
        color: var(--text);
      }

      .engine-by {
        display: block;
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-top: 2px;
      }

      .engine-desc {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        max-width: 58ch;
      }

      .engine-meta {
        font-size: var(--text-sm);
        color: var(--text-muted);
        text-align: right;
      }

      @media (max-width: 860px) {
        .engine-meta {
          text-align: left;
        }
      }

      /* ---- DOWNLOAD ---- */
      .download-panel {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 56px;
        align-items: start;
      }

      @media (max-width: 860px) {
        .download-panel {
          grid-template-columns: 1fr;
          gap: 36px;
        }
      }

      .download-list {
        border-top: 1px solid var(--border);
      }

      .download-row {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 16px;
        border-bottom: 1px solid var(--border);
        transition: background-color 160ms var(--ease), padding-left 160ms var(--ease);
      }

      a.download-row:hover {
        background: var(--bg-surface);
        padding-left: 22px;
      }

      .dl-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        display: grid;
        place-items: center;
        color: var(--text);
        flex-shrink: 0;
      }

      .dl-info {
        flex: 1;
        min-width: 0;
      }

      .dl-name {
        display: block;
        font-family: var(--font-display);
        font-size: var(--text-body);
        font-weight: 600;
        color: var(--text);
      }

      .dl-detail {
        display: block;
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .dl-arrow {
        color: var(--text-muted);
        flex-shrink: 0;
        transition: transform 160ms var(--ease), color 160ms var(--ease);
      }

      a.download-row:hover .dl-arrow {
        color: var(--accent);
        transform: translateX(3px);
      }

      .dl-all-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 24px;
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--accent);
        transition: color 160ms var(--ease);
      }

      .dl-all-link:hover {
        color: var(--accent-hover);
      }

      /* ---- FOOTER ---- */
      .footer {
        border-top: 1px solid var(--border);
        padding: 56px 0 36px;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 32px;
      }

      .footer-brand {
        max-width: 380px;
      }

      .footer-brand p {
        margin-top: 12px;
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      .footer-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
      }

      .footer-link {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        transition: color 160ms var(--ease);
      }

      .footer-link:hover {
        color: var(--text);
      }

      .footer-bottom {
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        font-size: var(--text-sm);
        color: var(--text-muted);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .marquee-track {
          animation: none;
        }
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
